# A patch: a stock oscillator and filter, then every Chloaelis unit, then a stock delay and limiter,
# all running in one chain for a while.
!packages core
!packages chloaelis

frames 20
lua (function() local M=require('Package.Manager') for id,p in pairs(M.getPackages()) do if not p.installed then M.install(p) end end return 'ok' end)()
frames 10
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('core')) do if u.moduleName=='Sine Osc' or u.title=='Sine Osc' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
frames 20
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('core')) do if u.moduleName=='Ladder LPF' or u.title=='Ladder LPF' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
frames 20
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='Filter' or u.title=='Filter' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
