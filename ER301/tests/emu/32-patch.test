lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('core')) do if u.moduleName=='Limiter' or u.title=='Limiter' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
frames 20
frames 600
lua (function() local c=require('Channels').getChain(1) local out={} for i=1,c:length() do out[#out+1]=c:getUnit(i).title end return c:length()..': '..table.concat(out,', ') end)()
!expect ^ok 10: 
cap @SHOTS@/patch.png
quit
