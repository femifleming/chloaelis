# What a unit's state keeps: faders, options, the string's scale, the tape's wear. Each unit is
# changed, serialized, and its state is given to a second unit of the same kind. (A loaded unit
# goes to the front of the chain: the two tapes are units 1 and 2, the two strings 3 and 4.)
!packages core
!packages chloaelis

frames 20
lua (function() local M=require('Package.Manager') for id,p in pairs(M.getPackages()) do if not p.installed then M.install(p) end end return 'ok' end)()
frames 10
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='String' or u.title=='String' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='String' or u.title=='String' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='TapeLoop' or u.title=='TapeLoop' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='TapeLoop' or u.title=='TapeLoop' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
frames 30
lua (function() local c=require('Channels').getChain(1) local a=c:getUnit(3) a.objects.poly:hardSet('Bias', 0.7) a.objects.sustain:hardSet('Bias', 1.05) a.op:setOptionValue('Damping', 3) local names={} for i=1,a.controls.scale.scaleList:size() do names[#names+1]=1 end a.controls.scale.scaleList:select(3) local name=a.controls.scale.scaleList:selectedText() a.controls.scale:loadBuiltinScale(name) local t=a:serialize() local b=c:getUnit(4) b:deserialize(t) return name..'|'..b.controls.scale.scaleList:selectedText()..'|'..string.format('%.2f %.2f %d', b.objects.poly:getParameter('Bias'):target(), b.objects.sustain:getParameter('Bias'):target(), b.op:getOptionValue('Damping')) end)()
!expect ^ok (.+)\|\1\|0.70 1.05 3
lua (function() local c=require('Channels').getChain(1) local a=c:getUnit(1) a.op:getParameter('Run Age'):hardSet(0.5) a.objects.time:hardSet('Bias', 0.75) a.op:setOptionValue('Time Mode', 2) return 'set' end)()
frames 60
lua (function() local c=require('Channels').getChain(1) local a=c:getUnit(1) local b=c:getUnit(2) local before=b.op:getParameter('Run Age'):target() local t=a:serialize() b:deserialize(t) return string.format('before %.3f', before) end)()
!expect before 0.00
frames 60
lua (function() local c=require('Channels').getChain(1) local b=c:getUnit(2) local age=b.op:getParameter('Run Age'):target() return string.format('age %s time %.2f mode %d', (age > 0.499 and age < 0.52) and 'kept' or tostring(age), b.objects.time:getParameter('Bias'):target(), b.op:getOptionValue('Time Mode')) end)()
!expect age kept time 0.75 mode 2
quit
