!expect loaded
frames 30
frames 300
lua (function() local c=require('Channels').getChain(1) local out={} for i=1,c:length() do local u=c:getUnit(i) out[#out+1]=u.title..':'..tostring(u.channelCount) end return table.concat(out,' ') end)()
!expect Scale String #1:2 Flock #1:2 Lorenz #1:2 Cell Filter #1:2 Tube #1:2 Tape Loop #1:2 BBD Delay #1:2 PT2399 Delay #1:2 Test Osc
lua (function() local c=require('Channels').getChain(1) local u=c:getUnit(8) local op=u.op return tostring(op:getInput('Right In') ~= nil)..' '..tostring(op:getOutput('Right Out') ~= nil) end)()
!expect true true
cap @SHOTS@/stereo-chain.png
quit
