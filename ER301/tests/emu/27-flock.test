# Flock: two of them in one chain follow two boids of the one flock; check the controls, take a picture.
!packages core
!packages chloaelis

frames 20
lua (function() local M=require('Package.Manager') for id,p in pairs(M.getPackages()) do if not p.installed then M.install(p) end end return 'ok' end)()
frames 10
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='Flock' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
lua (function() local F=require('Unit.Factory') local c=require('Channels').getChain(1) local ok='notfound' for _,u in ipairs(F.getUnitsByLibrary('chloaelis')) do if u.moduleName=='Flock' then local s,e=pcall(function() c:loadUnit(u) end) ok = s and 'loaded' or ('ERR '..tostring(e)) end end return ok end)()
!expect loaded
frames 200
lua (function() local c=require('Channels').getChain(1) local u=c:getUnit(1) if not u then return 'nounit' end local n=0 for k,v in pairs(u.controls) do n=n+1 end return u.title..' controls='..n end)()
!expect Flock.* controls=
lua (function() local c=require('Channels').getChain(1) local u=c:getUnit(2) u.objects.boid:hardSet('Bias', 6) return 'boid '..tostring(u.objects.boid:getParameter('Bias'):target()) end)()
!expect boid 6
frames 200
cap @SHOTS@/Flock.png
quit
